    color: Colors.primary500,
    fontWeight: "500",
    marginLeft: 8,
  },
  attachmentsList: {
    backgroundColor: Colors.white,
    borderRadius: 12,
    padding: 12,
    elevation: 2,
    shadowColor: "#000",
    shadowOffset: { width: 0, height: 1 },
