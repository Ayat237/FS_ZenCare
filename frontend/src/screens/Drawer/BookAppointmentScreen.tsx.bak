    fontWeight: "500",
  },

  // Notes
  notesContainer: {
    backgroundColor: Colors.white,
    borderRadius: 12,
    elevation: 2,
    shadowColor: "#000",
    shadowOffset: { width: 0, height: 1 },
    shadowOpacity: 0.22,
    shadowRadius: 2.22,
  },
  notesInput: {
    padding: 16,
    fontSize: 15,
    color: Colors.textPrimary,
    minHeight: 100,
    maxHeight: 150,
  },
  characterCount: {
    fontSize: 12,
    color: Colors.textMuted,
    textAlign: "right",
    paddingHorizontal: 16,
    paddingBottom: 12,
  },

  // File Upload
  uploadButton: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "center",
    backgroundColor: Colors.white,
    borderWidth: 2,
    borderColor: Colors.primary500,
    borderStyle: "dashed",
    borderRadius: 12,
