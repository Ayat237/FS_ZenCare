    marginBottom: 4,
  },
  doctorSpecialty: {
    fontSize: 14,
    color: Colors.primary500,
    fontWeight: "500",
    marginBottom: 8,
  },
  doctorStats: {
    flexDirection: "row",
  },
  statItem: {
